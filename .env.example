# ---------------------------------------------------------------------------
# Pencil API configuration. Copy to `.env` for local development.
# Every variable is validated at boot (src/config/env.schema.ts); the process
# refuses to start on a missing/invalid value.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=4100
# Deployment cell label (e.g. ksa-1, jo-1). Surfaces in logs / health.
APP_CELL=local
LOG_LEVEL=debug
# json | pretty (default: pretty in development, json otherwise)
LOG_FORMAT=pretty
# Set when running behind a load balancer / reverse proxy (true | hop count).
TRUST_PROXY=false
SWAGGER_ENABLED=true
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Runtime connection: restricted role, subject to row-level security.
DATABASE_URL=postgresql://pencil_app:pencil_app_dev@localhost:5432/pencil
# Migrations / seed: schema owner.
DATABASE_MIGRATION_URL=postgresql://pencil_owner:pencil_owner_dev@localhost:5432/pencil
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ISSUER=pencil-api
JWT_ACCESS_SECRET=change-me-tenant-access-secret-at-least-32-chars
JWT_PLATFORM_SECRET=change-me-platform-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PLATFORM_REFRESH_TOKEN_TTL_HOURS=12
COOKIE_SECURE=false

AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# Encrypts e-invoicing private keys and authority credentials at rest (32 bytes, base64).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Public URL of the tenant web app: links in invitation and password-reset emails.
APP_URL=http://localhost:3000

# Outgoing email (SMTP). Leave SMTP_HOST empty in development to log emails instead of sending.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an app password (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Pencil
# Receive-only inbox used as Reply-To.
SUPPORT_EMAIL=

# Retry pending ZATCA submissions in the background.
EINVOICING_WORKER_ENABLED=true
EINVOICING_WORKER_INTERVAL_SECONDS=60

# Used only by `npm run db:seed` to create the first platform super admin.
SEED_PLATFORM_ADMIN_EMAIL=admin@pencil.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!12345
