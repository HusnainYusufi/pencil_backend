# Runtime API: restricted role, subject to row-level security.
DATABASE_URL=postgresql://pencil_app:__PENCIL_APP_PASSWORD__@postgres:5432/pencil
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Separate, random signing keys for tenant users and platform staff.
JWT_ISSUER=pencil-api
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_PLATFORM_SECRET=__JWT_PLATFORM_SECRET__
# Encrypts e-invoicing private keys at rest. Losing it means re-onboarding every e-invoicing device.
DATA_ENCRYPTION_KEY=__DATA_ENCRYPTION_KEY__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PLATFORM_REFRESH_TOKEN_TTL_HOURS=12

# Browser origins of the tenant web app (comma-separated).
CORS_ORIGINS=__APP_ORIGIN__
# Public URL of the tenant web app: links in invitation and password-reset emails.
APP_URL=__APP_ORIGIN__

# Outgoing email (invitations, password reset). Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, app password.
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=__SMTP_PORT__
SMTP_SECURE=__SMTP_SECURE__
SMTP_USER=__SMTP_USER__
SMTP_PASSWORD=__SMTP_PASSWORD__
EMAIL_FROM=__EMAIL_FROM__
EMAIL_FROM_NAME=__EMAIL_FROM_NAME__
SUPPORT_EMAIL=__SUPPORT_EMAIL__

# Retries of pending ZATCA submissions.
EINVOICING_WORKER_ENABLED=true
EINVOICING_WORKER_INTERVAL_SECONDS=60
APP_CELL=__APP_CELL__
LOG_LEVEL=info
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
