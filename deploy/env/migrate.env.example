# Release job only: migrations run as the schema OWNER.
DATABASE_MIGRATION_URL=postgresql://pencil_owner:__PENCIL_OWNER_PASSWORD__@postgres:5432/pencil
# First platform super admin (created only if missing). After the first
# successful release, delete these two lines from env/migrate.env.
SEED_PLATFORM_ADMIN_EMAIL=__SEED_ADMIN_EMAIL__
SEED_PLATFORM_ADMIN_PASSWORD=__SEED_ADMIN_PASSWORD__
